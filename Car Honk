import json
import os
import argparse
from datetime import datetime

DATA_FILE = "tasks.json"


def load_tasks():
    if not os.path.exists(DATA_FILE):
        return []

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            return json.load(file)
    except (json.JSONDecodeError, OSError):
        return []


def save_tasks(tasks):
    with open(DATA_FILE, "w", encoding="utf-8") as file:
        json.dump(tasks, file, indent=2, ensure_ascii=False)


def add_task(title, priority):
    tasks = load_tasks()

    task = {
        "id": max([task["id"] for task in tasks], default=0) + 1,
        "title": title,
        "priority": priority,
        "status": "pending",
        "created_at": datetime.now().isoformat(timespec="seconds")
    }

    tasks.append(task)
    save_tasks(tasks)

    print(f"✓ Task #{task['id']} added.")


def list_tasks():
    tasks = load_tasks()

    if not tasks:
        print("No tasks found.")
        return

    priority_order = {
        "high": 1,
        "medium": 2,
        "low": 3
    }

    tasks.sort(key=lambda task: (
        task["status"] == "done",
        priority_order.get(task["priority"], 4)
    ))

    for task in tasks:
        status = "✓" if task["status"] == "done" else "○"

        print(
            f"{status} #{task['id']} | "
            f"{task['priority'].upper():6} | "
            f"{task['title']}"
        )


def complete_task(task_id):
    tasks = load_tasks()

    for task in tasks:
        if task["id"] == task_id:
            task["status"] = "done"
            save_tasks(tasks)
            print(f"✓ Task #{task_id} completed.")
            return

    print(f"Task #{task_id} not found.")


def delete_task(task_id):
    tasks = load_tasks()
    updated_tasks = [
        task for task in tasks
        if task["id"] != task_id
    ]

    if len(updated_tasks) == len(tasks):
        print(f"Task #{task_id} not found.")
        return

    save_tasks(updated_tasks)
    print(f"✓ Task #{task_id} deleted.")


def main():
    parser = argparse.ArgumentParser(
        description="TaskForge - A simple task management CLI."
    )

    subparsers = parser.add_subparsers(dest="command")

    add_parser = subparsers.add_parser(
        "add",
        help="Add a new task"
    )
    add_parser.add_argument("title")
    add_parser.add_argument(
        "-p",
        "--priority",
        choices=["low", "medium", "high"],
        default="medium"
    )

    subparsers.add_parser(
        "list",
        help="List all tasks"
    )

    complete_parser = subparsers.add_parser(
        "complete",
        help="Mark a task as completed"
    )
    complete_parser.add_argument("id", type=int)

    delete_parser = subparsers.add_parser(
        "delete",
        help="Delete a task"
    )
    delete_parser.add_argument("id", type=int)

    args = parser.parse_args()

    if args.command == "add":
        add_task(args.title, args.priority)

    elif args.command == "list":
        list_tasks()

    elif args.command == "complete":
        complete_task(args.id)

    elif args.command == "delete":
        delete_task(args.id)

    else:
        parser.print_help()


if __name__ == "__main__":
    main()
# TaskForge

TaskForge is a lightweight command-line task manager built with Python.

It helps you create, prioritize, complete, and remove tasks directly from your terminal.

## Features

- Add tasks
- Set task priority
- List tasks
- Mark tasks as completed
- Delete tasks
- Local JSON storage
- No external dependencies

## Requirements

- Python 3.9+

## Usage

### Add a task

```bash
python taskforge.py add "Finish project documentation"
python taskforge.py add "Deploy production build" --priority high
python taskforge.py list
python taskforge.py complete 1
python taskforge.py delete 1
✓ #2 | HIGH   | Deploy production build
○ #1 | MEDIUM | Finish project documentation
○ #3 | LOW    | Update README
